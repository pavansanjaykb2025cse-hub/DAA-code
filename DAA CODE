1-Number of Zeros in a Given Array


#include <stdio.h>

int countZeroes(int a[], int low, int high) {
    if (low > high)
        return 0;

    int mid = (low + high) / 2;

    // If mid is 0, count this and all elements after it
    if (a[mid] == 0) {
        return (high - mid + 1) + countZeroes(a, low, mid - 1);
    }

    // If mid is 1, search in the right half
    return countZeroes(a, mid + 1, high);
}

int main() {
    int m;

    scanf("%d", &m);

    int a[m];

    for (int i = 0; i < m; i++) {
        scanf("%d", &a[i]);
    }

    printf("%d", countZeroes(a, 0, m - 1));

    return 0;
}

