int main() {
    int n, a[1000], temp;
    long long sum = 0;

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Sort in ascending order
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    // Calculate maximum sum
    for (int i = 0; i < n; i++) {
        sum += (long long)a[i] * i;
    }

    printf("%lld", sum);

