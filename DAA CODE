2-DP-Playing with chessboard
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n][n];
    int dp[n][n];

    // Read the chessboard
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Starting position
    dp[0][0] = a[0][0];

    // First row
    for (int j = 1; j < n; j++) {
        dp[0][j] = dp[0][j - 1] + a[0][j];
    }

    // First column
    for (int i = 1; i < n; i++) {
        dp[i][0] = dp[i - 1][0] + a[i][0];
    }

    // Fill remaining cells
    for (int i = 1; i < n; i++) {
        for (int j = 1; j < n; j++) {
            if (dp[i - 1][j] > dp[i][j - 1])
                dp[i][j] = dp[i - 1][j] + a[i][j];
            else
                dp[i][j] = dp[i][j - 1] + a[i][j];
        }
    }

    // Maximum path value
    printf("%d", dp[n - 1][n - 1]);

    return 0;
}


3-DP-Longest Common Subsequence
#include <stdio.h>
#include <string.h>

int main() {
    char s1[1000], s2[1000];

    scanf("%s", s1);
    scanf("%s", s2);

    int m = strlen(s1);
    int n = strlen(s2);

    int dp[m + 1][n + 1];

    // Initialize first row and first column
    for (int i = 0; i <= m; i++) {
        dp[i][0] = 0;
    }

    for (int j = 0; j <= n; j++) {
        dp[0][j] = 0;
    }

    // Fill DP table
    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {

            if (s1[i - 1] == s2[j - 1]) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
            }
            else {
                if (dp[i - 1][j] > dp[i][j - 1])
                    dp[i][j] = dp[i - 1][j];
                else
                    dp[i][j] = dp[i][j - 1];
            }
        }
    }

    printf("%d", dp[m][n]);

    return 0;
}

4-DP-Longest non-decreasing Subsequence
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n];
    int dp[n];

    // Read the sequence
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        dp[i] = 1;
    }

    // Find Longest Non-decreasing Subsequence
    for (int i = 1; i < n; i++) {
        for (int j = 0; j < i; j++) {

            if (a[j] <= a[i] && dp[j] + 1 > dp[i]) {
                dp[i] = dp[j] + 1;
            }
        }
    }

    // Find maximum length
    int max = dp[0];

    for (int i = 1; i < n; i++) {
        if (dp[i] > max) {
            max = dp[i];
        }
    }

    printf("%d", max);

    return 0;
}
