3-Finding Floor Value


#include <stdio.h>

int findFloor(int a[], int low, int high, int x) {
    if (low > high)
        return -1;

    int mid = (low + high) / 2;

    if (a[mid] == x)
        return a[mid];

    if (a[mid] < x) {
        int result = findFloor(a, mid + 1, high, x);

        if (result == -1)
            return a[mid];

        return result;
    }

    return findFloor(a, low, mid - 1, x);
}

int main() {
    int n, x;

    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &x);

    printf("%d", findFloor(a, 0, n - 1, x));

    return 0;
}



4-Two Elements sum to x


#include <stdio.h>

int binarySearch(int a[], int low, int high, int key) {
    if (low > high)
        return -1;

    int mid = (low + high) / 2;

    if (a[mid] == key)
        return mid;

    if (a[mid] < key)
        return binarySearch(a, mid + 1, high, key);

    return binarySearch(a, low, mid - 1, key);
}

int main() {
    int n, x;

    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &x);

    for (int i = 0; i < n; i++) {
        int j = binarySearch(a, i + 1, n - 1, x - a[i]);

        if (j != -1) {
            printf("%d\n", a[i]);
            printf("%d\n", a[j]);
            return 0;
        }
    }

    printf("No");

    return 0;
}



5-Implementation of Quick Sort

#include <stdio.h>

void quickSort(int arr[], int low, int high)
{
    if (low < high)
    {
        int pivot = arr[high];
        int i = low - 1;

        for (int j = low; j < high; j++)
        {
            if (arr[j] < pivot)
            {
                i++;
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }

        int temp = arr[i + 1];
        arr[i + 1] = arr[high];
        arr[high] = temp;

        int p = i + 1;

        quickSort(arr, low, p - 1);
        quickSort(arr, p + 1, high);
    }
}

int main()
{
    int n;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    quickSort(arr, 0, n - 1);

    for (int i = 0; i < n; i++)
    {
        if (i > 0)
            printf(" ");
        printf("%d", arr[i]);
    }

    return 0;
}

