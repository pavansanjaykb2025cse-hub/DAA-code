Problem 4: Finding Complexity using Counter Method

#include <stdio.h>

int main()
{
    int n;
    scanf("%d", &n);

    int c = 0;

    int i = n / 2;
    c++;   // for initialization

    while (1)
    {
        c++;   // i < n

        if (i >= n)
            break;

        int j = 1;

        while (1)
        {
            c++;  

            if (j >= n)
                break;

            int k = 1;

            while (1)
            {
                c++;  

                if (k >= n)
                    break;
                c++;

                k = k * 2;
            }

            j = 2 * j;
        }

        i++;
    }

    printf("%d", c);

    return 0;
}


